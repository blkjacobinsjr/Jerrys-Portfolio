---
import { Font } from 'astro:assets';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import { HERO_ZOOM, WORK_DETAILS, flagState } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const details = flagState(WORK_DETAILS);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
// The looping link-preview reel (tools/og-video.mjs). Only link cards fetch it, never the page.
const ogVideo = new URL('/og.mp4', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:video" content={ogVideo} />
    <meta property="og:video:secure_url" content={ogVideo} />
    <meta property="og:video:type" content="video/mp4" />
    <meta property="og:video:width" content="1200" />
    <meta property="og:video:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-sans" preload />
    {details !== 'off' && (
      <script is:inline define:vars={{ needsQuery: details === 'query' }}>
        // WORK_DETAILS: Overworld-style project pages, desktop with a fine pointer only. In preview builds ?details=1
        // turns it on for the tab session (?details=0 off), so it survives the click from the home page.
        (function () {
          try {
            var q = new URLSearchParams(location.search).get('details');
            if (q === '1') sessionStorage.setItem('jp-details', '1');
            if (q === '0') sessionStorage.removeItem('jp-details');
            var on = !needsQuery || sessionStorage.getItem('jp-details') === '1';
            if (on && matchMedia('(min-width: 900px) and (hover: hover) and (pointer: fine)').matches) document.documentElement.dataset.workDetails = 'on';
          } catch (e) {}
        })();
      </script>
    )}
    <slot name="head" />
    {HERO_ZOOM && (
      <script is:inline define:vars={{ mode: HERO_ZOOM }}>
        // Before first paint: the E3 hero runs only on a desktop with a fine pointer, motion allowed and CSS
        // scroll timelines; everyone else gets the static hero. ?zoom=off turns it off for a visit.
        (function () {
          var q = new URLSearchParams(location.search).get('zoom');
          var ok = matchMedia('(min-width: 900px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches;
          if (q !== 'off' && mode && ok && CSS.supports('animation-timeline: scroll()')) document.documentElement.dataset.heroZoom = mode;
        })();
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      const userIntents = ['wheel', 'touchstart', 'keydown', 'pointerdown'] as const;
      const recordUserIntent = () => {
        document.documentElement.dataset.userIntent = 'true';
        for (const type of userIntents) removeEventListener(type, recordUserIntent, true);
      };
      const trackUserIntent = () => {
        for (const type of userIntents) addEventListener(type, recordUserIntent, { capture: true, passive: true, once: true });
      };

      // Motion is an enhancement: fetch it a beat after the page has loaded,
      // once idle (same timing as client:afterload).
      const start = () => {
        import('../motion').then((motion) => motion.start());
        import('../lib/sound').then((sound) => sound.initSound());
      };
      const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 1500 }) : setTimeout(start, 1));
      const later = () => setTimeout(idle, 250);
      const afterLoad = () => {
        trackUserIntent();
        later();
      };
      if (document.readyState === 'complete') afterLoad();
      else addEventListener('load', afterLoad, { once: true });
    </script>
  </body>
</html>
