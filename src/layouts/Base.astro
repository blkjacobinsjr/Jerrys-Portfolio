---
import { Font } from 'astro:assets';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import { HERO_ZOOM } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
// The looping link-preview reel (tools/og-video.mjs). Only link cards fetch it, never the page.
const ogVideo = new URL('/og.mp4', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:video" content={ogVideo} />
    <meta property="og:video:secure_url" content={ogVideo} />
    <meta property="og:video:type" content="video/mp4" />
    <meta property="og:video:width" content="1200" />
    <meta property="og:video:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-sans" preload />
    <slot name="head" />
    {HERO_ZOOM && (
      // Before first paint: E3 only on a wide screen with a mouse/trackpad (any-hover/any-pointer, so phones and touch
      // tablets never match), motion allowed and CSS scroll timelines; ?zoom=off turns it off for a visit. The reason it
      // is off lands in data-hero-zoom-off; hero-boot.ts re-runs the check on resize while at the top. Kept minified:
      // these bytes sit in every phone's head before the LCP image.
      <script is:inline set:html={`(function(){var mode=${JSON.stringify(HERO_ZOOM)},r=document.documentElement;window.__heroZoom=function(){var m=function(q){return matchMedia(q).matches},o=new URLSearchParams(location.search).get('zoom')==='off'?'query':!m('(min-width: 900px)')?'width':!m('(any-hover: hover) and (any-pointer: fine)')?'pointer':m('(prefers-reduced-motion: reduce)')?'motion':!CSS.supports('animation-timeline: scroll()')?'timeline':'';if(o)r.dataset.heroZoomOff=o;else{delete r.dataset.heroZoomOff;r.dataset.heroZoom=mode}return!o};if(mode)window.__heroZoom()})();`} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/hero-boot';
      const userIntents = ['wheel', 'touchstart', 'keydown', 'pointerdown'] as const;
      const recordUserIntent = () => {
        document.documentElement.dataset.userIntent = 'true';
        for (const type of userIntents) removeEventListener(type, recordUserIntent, true);
      };
      const trackUserIntent = () => {
        for (const type of userIntents) addEventListener(type, recordUserIntent, { capture: true, passive: true, once: true });
      };

      // Motion is an enhancement: fetch it a beat after the page has loaded,
      // once idle (same timing as client:afterload).
      const start = () => {
        import('../motion').then((motion) => motion.start());
        import('../lib/sound').then((sound) => sound.initSound());
      };
      const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 1500 }) : setTimeout(start, 1));
      const later = () => setTimeout(idle, 250);
      const afterLoad = () => {
        trackUserIntent();
        later();
      };
      if (document.readyState === 'complete') afterLoad();
      else addEventListener('load', afterLoad, { once: true });
    </script>
  </body>
</html>
