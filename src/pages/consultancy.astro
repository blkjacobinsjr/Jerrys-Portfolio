---
import Page from '../layouts/Page.astro';
import ConsultancyBadge from '../components/ConsultancyBadge';
import front from '../assets/lanyard/leapfrog-front.webp';
import back from '../assets/lanyard/leapfrog-back.webp';
import strap from '../assets/lanyard/leapfrog-strap.webp';
import poster from '../assets/lanyard/leapfrog-poster.webp';

const LFG = 'https://lfg-ai.com';
---

<Page
  page="consultancy"
  title="Consultancy, Jerry Doughan, Founder of Leapfrog AI"
  description="I run Leapfrog AI, an AI consultancy that designs and ships AI products and workflows for mid-market companies."
>
  <link slot="head" rel="preload" as="image" href={poster.src} fetchpriority="high" />
  <h1 class="sr-only">Jerry Doughan, Founder of Leapfrog AI</h1>
  <section class="badge-stage" aria-label="My Leapfrog AI badge. Drag it, or tap to flip it.">
    <ConsultancyBadge
      client:afterload
      image={poster.src}
      alt="A green Leapfrog AI badge: Jerry Doughan, Founder of Leapfrog AI"
      options={{
        frontImage: front.src,
        alt: 'A green Leapfrog AI badge: Jerry Doughan, Founder of Leapfrog AI',
        backImage: back.src,
        strapImage: strap.src,
        strapColor: '#064E3B',
        finish: 'glossy',
        metal: 'silver',
        cornerRadius: 0.25,
        size: 0.62,
        strapLength: 0.42,
        breeze: 0.2,
        intro: false,
        swing: 2.2,
      }}
    />
  </section>
  <p class="lfg">
    <a href={LFG} rel="noopener" target="_blank">lfg-ai.com <span aria-hidden="true">↗</span></a>
  </p>
</Page>

<style>
  .badge-stage {
    position: relative;
    width: min(100% - 2 * var(--gutter), 44rem);
    height: min(62svh, 40rem);
    margin-inline: auto;
  }

  .badge-stage :global(.badge) {
    position: absolute;
    inset: 0;
  }

  /* The poster is the lanyard's first frame, drawn in the box the canvas fills (the stage above the Flip row).
     It sits over the live model until the first WebGL frame is on screen, then fades out: opacity only. */
  .badge-stage :global(.badge-poster) {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    pointer-events: none;
    transition: opacity var(--dur-ui) var(--ease-out);
  }

  .badge-stage :global(.badge-poster[data-covered='false']) {
    opacity: 0;
  }

  .badge-stage :global(.badge-poster__stage) {
    position: relative;
  }

  .badge-stage :global(.badge-poster img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* The live model's own flat fallback must never show: the poster covers it while loading, and once the canvas
     is up it only stays in the accessibility tree, as the badge's picture description. */
  .badge-stage :global(.badge[data-live] .lanyard-fallback) {
    visibility: visible !important;
    opacity: 0;
    pointer-events: none;
  }

  .badge-stage :global(.badge[data-live] .model-loader__fallback) {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .badge-stage :global(.badge-poster) {
      transition: none;
    }
  }

  .lfg {
    margin-top: clamp(1.5rem, 5vh, 3rem);
    text-align: center;
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .lfg a {
    display: inline-block;
    padding: 0.6rem 1.1rem;
    border-radius: var(--r-pill);
    background: var(--bg-sunk);
    text-decoration: none;
    transition: background var(--dur-ui) var(--ease-out), scale var(--dur-press) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .lfg a:hover {
      background: var(--line);
    }
  }

  .lfg a:active {
    scale: 0.97;
  }
</style>
