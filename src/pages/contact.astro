---
import { Font } from 'astro:assets';
import Page from '../layouts/Page.astro';
import Letter from '../components/Letter';
import note from '../assets/contact/note.webp';
import { person } from '../data/site';
---

<Page
  page="contact"
  title="Contact, Jerry Doughan"
  description="Write Jerry Doughan a letter: a new product, consultancy at Leapfrog AI, or just a hello."
>
  <Font slot="head" cssVariable="--font-mono" preload />
  <Letter client:afterload email={person.email} note={note.src} />
  <p class="letter-alt muted">
    Rather skip the letter? <a href={`mailto:${person.email}`}>{person.email}</a> · <a href={person.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
  </p>
</Page>

<style>
  .letter-alt {
    margin-top: 2rem;
    text-align: center;
    font-size: var(--text-sm);
  }
</style>
