---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import EnterScreen from '../components/EnterScreen.astro';
import WorkSection from '../components/WorkSection.astro';
import Path from '../components/Path.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Dock from '../components/Dock';
import sprite from '../assets/mascot/sprite.webp';
import still from '../assets/mascot/still.webp';
import { person, projects } from '../data/site';
import '../styles/work-transition.css';
import { getImage } from 'astro:assets';
import desk from '../assets/icons/desk.webp';
// The hero desk is the mobile LCP: preload the same AVIF set the <Picture> in Hero picks from.
const deskLcp = await getImage({ src: desk, widths: [320, 400, 480, 560, 640, 760, 1040], format: 'avif', quality: 46 });
---

<Base
  title={`${person.name}, product designer and frontend developer`}
  description="Jerry Doughan designs and builds consumer apps that feel good in the first five seconds. Co-founder of Scenaryo. Berlin."
>
  <script slot="head" is:inline define:vars={{ ids: projects.map((project) => project.id) }}>
    // A link from when projects opened in a drawer (/#work/<id> or ?project=<id>) goes to the project's page.
    {
      const id = (/^#work\/([\w-]+)$/.exec(location.hash) ?? /[?&]project=([\w-]+)/.exec(location.search))?.[1];
      if (id && ids.includes(id)) location.replace('/work/' + id);
    }
  </script>
  <link slot="head" rel="preload" as="image" type="image/avif" fetchpriority="high" imagesrcset={deskLcp.srcSet.attribute} imagesizes="(min-width: 900px) 520px, 72vw" />
  <EnterScreen />
  <main id="main" class="page" data-scrollsheet-background>
    <Hero sprite={sprite.src} still={still.src} />
    <WorkSection />
    <Path />
    <About />
  </main>
  <Contact />
  <Dock client:afterload sprite={sprite.src} still={still.src} />
</Base>

<style>
  .page {
    position: relative;
    z-index: 1;
    background: var(--bg);
    border-radius: 0 0 clamp(24px, 4vw, 40px) clamp(24px, 4vw, 40px);
    box-shadow: 0 30px 60px -30px rgb(var(--shadow-tint) / 0.35);
  }
</style>
