---
import signature from './signature-data.json';

// The traced timings run ~4.1s; play them at DRAW_SECONDS in total.
const DRAW_SECONDS = 1.8;
const last = signature.strokes[signature.strokes.length - 1]!.timing;
const speed = DRAW_SECONDS / (last.start + last.duration);
---

<button type="button" class="hero-signature-replay" data-signature-replay aria-label="Replay signature">
<svg
  class="hero-signature"
  data-signature
  viewBox={signature.viewBox}
  aria-hidden="true"
>
  {signature.strokes.map((stroke, index) => {
    const maskId = `hero-signature-mask-${index}`;
    const easing = `linear(${stroke.timing.stops.map((stop) => `${stop[1] ?? 0} ${((stop[0] ?? 0) * 100).toFixed(2)}%`).join(', ')})`;

    return (
      <g
        style={`--signature-delay:${(stroke.timing.start * speed).toFixed(3)}s;--signature-duration:${(stroke.timing.duration * speed).toFixed(3)}s;--signature-easing:${easing}`}
      >
        <mask
          id={maskId}
          x="0"
          y="0"
          width={signature.width}
          height={signature.height}
          maskUnits="userSpaceOnUse"
          maskContentUnits="userSpaceOnUse"
          style="mask-type: luminance"
        >
          <path
            class="signature-mask"
            data-signature-mask
            d={stroke.centerline}
            fill="none"
            stroke="white"
            stroke-width={stroke.maskWidth}
            stroke-linecap="round"
            stroke-linejoin="round"
            pathLength="1"
          />
        </mask>
        <path data-signature-fill d={stroke.fill} fill="currentColor" mask={`url(#${maskId})`} />
      </g>
    );
  })}
</svg>
<script>
  // Replay the draw-in. Under reduced motion no animation runs, so the signature is already whole and stays so.
  document.querySelector<HTMLElement>('[data-signature-replay]')?.addEventListener('click', (event) => {
    for (const animation of event.currentTarget instanceof Element ? event.currentTarget.getAnimations({ subtree: true }) : []) {
      animation.currentTime = 0;
      animation.play();
    }
  });
</script>
</button>

<style>
  /* Press state: the site's press scale (transitions.dev press token, --dur-press). */
  .hero-signature-replay {
    display: block;
    width: min(100%, 16rem);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: scale var(--dur-press) var(--ease-out);
  }

  .hero-signature-replay:active {
    scale: 0.97;
  }

  .hero-signature-replay:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-signature-replay {
      transition: none;
    }
  }

  .hero-signature {
    display: block;
    width: 100%;
    aspect-ratio: 554 / 354;
    color: var(--fg);
  }

  /* On phones a 16rem signature pushes the teaser far down; ~8rem keeps it a flourish. */
  @media (max-width: 767px) {
    .hero-signature-replay {
      width: min(100%, 8rem);
    }
  }

  .signature-mask {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .signature-mask {
      animation: signature-reveal var(--signature-duration) linear var(--signature-delay) 1 both;
      animation-timing-function: var(--signature-easing);
    }
  }

  @keyframes signature-reveal {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
