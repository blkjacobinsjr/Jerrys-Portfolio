---
import { getImage, Picture } from 'astro:assets';
import Mascot from './Mascot';
import DecryptedText from './DecryptedText';
import desk from '../assets/icons/desk.webp';
import screen from '../assets/icons/screen-berlin.webp';
import { HERO_ZOOM, HERO_ZOOM_PREVIEW, person } from '../data/site';
import { teaser } from '../data/recommendations';
import MinimalTestimonial from './MinimalTestimonial';
import Signature from './Signature.astro';
import StartupPrograms from './StartupPrograms.astro';

interface Props {
  sprite: string;
  still: string;
}
const { sprite, still } = Astro.props;
// Three verbatim lines from the recommendations (data/recommendations.ts), portraits at 2x their 40px.
const quotes = await Promise.all(
  teaser.map(async ({ name, fragment, org, linkedin, portrait, logo }) => ({
    quote: fragment.charAt(0).toUpperCase() + fragment.slice(1),
    name,
    role: org,
    href: linkedin,
    image: (await getImage({ src: portrait, width: 80, height: 80, format: 'webp' })).src,
    logo: logo && (await getImage({ src: logo, width: 28, height: 28, format: 'webp' })).src,
  })),
);
---

<div class="hero-pin" data-hero-pin data-mode={HERO_ZOOM || undefined}>
<header class="hero wide" id="top">
  <div class="hero-copy">
    <div class="hero-id">
      <Mascot client:afterload sprite={sprite} still={still} size={56} label="Poke Jerry’s mascot" />
      <div>
        <h1><DecryptedText client:afterload="(hover: hover) and (pointer: fine)" text={person.name} sequential speed={40} encryptedClassName="decrypting" /></h1>
        <p class="muted">{person.role}</p>
      </div>
    </div>
    <p class="hero-bio">
      I design and build consumer apps that feel good in the first five seconds. Right now that is{' '}
      <a href="#work">Scenaryo</a>, a fanfiction layer for movies.
    </p>
    <Signature />
    <p class="hero-links">
      <a href={`mailto:${person.email}`}>Email</a>
      <a href={person.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
      <a href={person.github} rel="me noopener" target="_blank">GitHub</a>
    </p>
    <div class="hero-recs" role="group" aria-label="From my recommendations">
      <MinimalTestimonial client:afterload testimonials={quotes} />
      <a class="hero-recs-all" href="#recommendations">All six recommendations</a>
    </div>
  </div>

  <div class="hero-art-col">
  <figure class="hero-art" data-hero-art>
    <Picture
      src={desk}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      alt="A miniature 3D model of Jerry’s Berlin desk: a laptop showing the TV tower, a Kindle with a highlighter, headphones, a plant and an e-bike"
      widths={[320, 400, 480, 560, 640, 760, 1040]}
      quality={46}
      sizes="(min-width: 900px) 520px, 72vw"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </figure>
  <StartupPrograms />
  </div>
</header>
{HERO_ZOOM_PREVIEW && (
  <div class="hero-screen" data-hero-screen aria-hidden="true">
    <Picture
      src={screen}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      alt=""
      widths={[480, 828, 1280, 1920, 2560]}
      quality={50}
      sizes="(max-width: 899px) 340px, max(100vw, 160svh)"
      loading="eager"
      decoding="async"
      fetchpriority={HERO_ZOOM === 'start-inside' ? 'high' : 'low'}
    />
  </div>
)}
</div>

<script>
  import { heroZoom } from '../scripts/hero-zoom';
  heroZoom();
</script>

<style>
  .hero {
    display: grid;
    align-items: center;
    gap: 2rem;
    min-height: min(100svh, 56rem);
    padding-block: clamp(3rem, 10vh, 6rem) 2rem;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
      gap: clamp(2rem, 6vw, 6rem);
    }
  }

  .hero-copy {
    display: grid;
    gap: 1.25rem;
    max-width: 28rem;
  }

  .hero-id {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  h1 {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .hero-id p {
    font-size: var(--text-sm);
  }

  .hero-bio {
    font-size: clamp(var(--text-lg), 1rem + 0.5vw, 1.3125rem);
    line-height: 1.55;
    letter-spacing: -0.012em;
  }

  .hero-links {
    display: flex;
    gap: 1.25rem;
    font-size: var(--text-sm);
    color: var(--fg-2);
  }

  .hero-recs {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  .hero-recs-all {
    font-size: var(--text-sm);
    color: var(--fg-2);
  }

  .hero-art-col {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    justify-self: center;
    width: min(72vw, 34rem);
  }

  .hero-art {
    width: 100%;
    will-change: transform;
  }




  .hero-art :global(picture) {
    display: block;
  }

  .hero-art :global(img) {
    width: 100%;
    filter: drop-shadow(0 30px 40px rgb(var(--shadow-tint) / 0.12));
  }

  /* First paint: copy settles in, the desk floats up a beat later. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * {
      animation: hero-in var(--dur-reveal) var(--ease-out) both;
    }
    .hero-copy > :nth-child(2) {
      animation-delay: 80ms;
    }
    .hero-copy > :nth-child(3) {
      animation-delay: 150ms;
    }
    .hero-copy > :nth-child(4) {
      animation-delay: 220ms;
    }
    .hero-copy > :nth-child(5) {
      animation-delay: 220ms;
    }
    .hero-art {
      animation: hero-art-in var(--dur-reveal) var(--ease-out) both;
    }
  }

  /* Visible from the first frame (so it is the first contentful paint); it only settles. */
  @keyframes hero-in {
    from {
      transform: translateY(8px);
      filter: blur(3px);
    }
  }

  /* Transform only: an opacity fade would hold back LCP. */
  @keyframes hero-art-in {
    from {
      transform: translateY(28px) scale(0.96);
    }
  }

  /* t141: one fixed copy of the screen (16:10, sized to cover the viewport) that hero-zoom.ts maps between
     full-bleed and the laptop's perspective quad with a matrix3d per frame. Transform and opacity only. */
  .hero-screen {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-hero-zoom]) .hero-screen {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 5;
      width: max(100vw, 160svh);
      aspect-ratio: 16 / 10;
      transform-origin: 0 0;
      pointer-events: none;
      contain: strict;
      will-change: transform, opacity;
    }
    :global(html[data-hero-zoom='dive-in']) .hero-screen {
      z-index: 0;
      opacity: 0;
    }
    .hero-screen :global(img) {
      display: block;
      width: 100%;
      height: 100%;
      border-radius: inherit;
    }
    /* Desktop pins the hero while the screen travels, so the end state is the hero exactly as it is today. */
    @media (min-width: 900px) {
      :global(html[data-hero-zoom='start-inside']) .hero-pin {
        height: calc(100svh + 70vh);
      }
      :global(html[data-hero-zoom='dive-in']) .hero-pin {
        height: calc(100svh + 90vh);
      }
      :global(html[data-hero-zoom]) .hero {
        position: sticky;
        top: 0;
        height: 100svh;
        min-height: 0;
      }
    }
    :global(html[data-hero-zoom='start-inside']) .hero-copy > * {
      animation: none;
    }
    :global(html[data-hero-zoom='start-inside']) .hero-copy {
      opacity: 0;
    }
    :global(html[data-hero-zoom='dive-in'] #work) {
      position: relative;
      z-index: 1;
    }
  }
</style>
