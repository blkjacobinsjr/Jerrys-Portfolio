---
import { getImage, Picture } from 'astro:assets';
import Mascot from './Mascot';
import DecryptedText from './DecryptedText';
import desk from '../assets/icons/desk.webp';
import screen from '../assets/icons/screen-v3.webp';
import deskBare from '../assets/icons/desk-nolaptop.webp';
import deskLanded from '../assets/icons/desk-landed.webp';
import { HERO_ZOOM, person } from '../data/site';
import { teaser } from '../data/recommendations';
import MinimalTestimonial from './MinimalTestimonial';
import Signature from './Signature.astro';
import StartupPrograms from './StartupPrograms.astro';

interface Props {
  sprite: string;
  still: string;
}
const { sprite, still } = Astro.props;
// E3 (desktop only): every extra image is a CSS background set only under html[data-hero-zoom], so phones,
// touch, reduced motion and ?zoom=off never fetch them. The v3 screen opens full-bleed; the bare desk (laptop
// inpainted out) carries the flight; the landed desk is the drawn laptop showing v3.
const img = async (src: ImageMetadata, width: number, format: 'avif' | 'webp', quality = 50) => (await getImage({ src, width, format, quality })).src;
const e3 = HERO_ZOOM
  ? [
      `--e3-screen: image-set(url(${await img(screen, 2560, 'avif', 45)}) type("image/avif"), url(${await img(screen, 2560, 'webp')}) type("image/webp"))`,
      `--e3-bare: url(${await img(deskBare, 1040, 'webp')})`,
      `--e3-landed: url(${await img(deskLanded, 1040, 'webp')})`,
    ].join(';')
  : undefined;
// Three verbatim lines from the recommendations (data/recommendations.ts), portraits at 2x their 40px.
const quotes = await Promise.all(
  teaser.map(async ({ name, fragment, org, linkedin, portrait, logo }) => ({
    quote: fragment.charAt(0).toUpperCase() + fragment.slice(1),
    name,
    role: org,
    href: linkedin,
    image: (await getImage({ src: portrait, width: 80, height: 80, format: 'webp' })).src,
    logo: logo && (await getImage({ src: logo, width: 28, height: 28, format: 'webp' })).src,
  })),
);
---

<div class="hero-pin" data-hero-pin style={e3}>
<header class="hero wide" id="top">
  <div class="hero-copy">
    <div class="hero-id">
      <Mascot client:afterload sprite={sprite} still={still} size={56} label="Poke Jerry’s mascot" />
      <div>
        <h1><DecryptedText client:afterload="(hover: hover) and (pointer: fine)" text={person.name} sequential speed={40} encryptedClassName="decrypting" /></h1>
        <p class="muted">{person.role}</p>
      </div>
    </div>
    <p class="hero-bio">
      I design and build consumer apps that feel good in the first five seconds. Right now that is{' '}
      <a href="#work">Scenaryo</a>, a fanfiction layer for movies.
    </p>
    <Signature />
    <p class="hero-links">
      <a href={`mailto:${person.email}`}>Email</a>
      <a href={person.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
      <a href={person.github} rel="me noopener" target="_blank">GitHub</a>
    </p>
    <div class="hero-recs" role="group" aria-label="From my recommendations">
      <MinimalTestimonial client:afterload testimonials={quotes} />
      <a class="hero-recs-all" href="#recommendations">All six recommendations</a>
    </div>
  </div>

  <div class="hero-art-col">
  <figure class="hero-art" data-hero-art>
    <Picture
      src={desk}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      alt="A miniature 3D model of Jerry’s Berlin desk: a laptop showing the TV tower, a Kindle with a highlighter, headphones, a plant and an e-bike"
      widths={[320, 400, 480, 560, 640, 760, 1040]}
      quality={46}
      sizes="(min-width: 900px) 520px, 72vw"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    {HERO_ZOOM && <div class="hero-landed" aria-hidden="true"></div>}
    {HERO_ZOOM && <div class="hero-bare" aria-hidden="true"></div>}
  </figure>
  <StartupPrograms />
  </div>
</header>
{HERO_ZOOM && <div class="hero-screen" data-hero-screen aria-hidden="true"></div>}
{HERO_ZOOM && <canvas class="hero-laptop" data-hero-laptop aria-hidden="true"></canvas>}
</div>

<script>
  // The attribute is only ever set on a desktop with a fine pointer (Base.astro), so phones never load three.js.
  const boot = () => import('../scripts/hero-laptop').then((m) => m.heroLaptop());
  if (document.documentElement.dataset.heroZoom === 'laptop') boot();
  // The enter screen re-runs the E3 check on its click and asks for the laptop if it now passes.
  else addEventListener('hero-zoom', boot, { once: true });
</script>

<style>
  .hero {
    display: grid;
    align-items: center;
    gap: 2rem;
    min-height: min(100svh, 56rem);
    padding-block: clamp(3rem, 10vh, 6rem) 2rem;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
      gap: clamp(2rem, 6vw, 6rem);
    }
  }

  .hero-copy {
    display: grid;
    gap: 1.25rem;
    max-width: 28rem;
  }

  .hero-id {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  h1 {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .hero-id p {
    font-size: var(--text-sm);
  }

  .hero-bio {
    font-size: clamp(var(--text-lg), 1rem + 0.5vw, 1.3125rem);
    line-height: 1.55;
    letter-spacing: -0.012em;
  }

  .hero-links {
    display: flex;
    gap: 1.25rem;
    font-size: var(--text-sm);
    color: var(--fg-2);
  }

  .hero-recs {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }

  .hero-recs-all {
    font-size: var(--text-sm);
    color: var(--fg-2);
  }

  .hero-art-col {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    justify-self: center;
    width: min(72vw, 34rem);
  }

  .hero-art {
    width: 100%;
    will-change: transform;
  }




  .hero-art :global(picture) {
    display: block;
  }

  .hero-art :global(img) {
    width: 100%;
    filter: drop-shadow(0 30px 40px rgb(var(--shadow-tint) / 0.12));
  }

  /* First paint: copy settles in, the desk floats up a beat later. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * {
      animation: hero-in var(--dur-reveal) var(--ease-out) both;
    }
    .hero-copy > :nth-child(2) {
      animation-delay: 80ms;
    }
    .hero-copy > :nth-child(3) {
      animation-delay: 150ms;
    }
    .hero-copy > :nth-child(4) {
      animation-delay: 220ms;
    }
    .hero-copy > :nth-child(5) {
      animation-delay: 220ms;
    }
    .hero-art {
      animation: hero-art-in var(--dur-reveal) var(--ease-out) both;
    }
  }

  /* Visible from the first frame (so it is the first contentful paint); it only settles. */
  @keyframes hero-in {
    from {
      transform: translateY(8px);
      filter: blur(3px);
    }
  }

  /* Transform only: an opacity fade would hold back LCP. */
  @keyframes hero-art-in {
    from {
      transform: translateY(28px) scale(0.96);
    }
  }

  /* E3 hero (desktop + fine pointer only; html[data-hero-zoom='laptop'] is set in Base.astro). The page opens on
     the v3 screen full-bleed; scroll pulls back as hero-laptop.ts spins a 3D laptop onto the desk. CSS scroll
     timelines own every fade (transform/opacity only); without them the attribute is never set. */
  .hero-screen,
  .hero-bare,
  .hero-landed,
  .hero-laptop {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) and (min-width: 900px) {
    /* No fixed layers (overlay.test): the screen, the canvas and the hero share one grid cell in the pin, each
       sticky at the top for the whole travel. */
    :global(html[data-hero-zoom='laptop']) .hero-pin {
      display: grid;
      height: calc(100svh + 90vh);
    }
    :global(html[data-hero-zoom='laptop']) .hero-pin > * {
      grid-area: 1 / 1;
      align-self: start;
    }
    :global(html[data-hero-zoom='laptop']) .hero {
      position: sticky;
      top: 0;
      height: 100svh;
      min-height: 0;
    }
    :global(html[data-hero-zoom='laptop']) .hero-art {
      display: grid;
      animation: none;
    }
    :global(html[data-hero-zoom='laptop']) .hero-art > :global(*) {
      grid-area: 1 / 1;
    }
    :global(html[data-hero-zoom='laptop']) .hero-copy > * {
      animation: none;
    }
    :global(html[data-hero-zoom='laptop']) .hero-copy {
      animation: e3-copy linear both;
      animation-timeline: scroll(root);
      animation-range: 40vh 80vh;
    }
    :global(html[data-hero-zoom='laptop']) .hero-screen {
      display: block;
      position: sticky;
      top: 0;
      width: 100%;
      height: 100svh;
      z-index: 5;
      background: var(--e3-screen) center / cover no-repeat #10203a;
      pointer-events: none;
      contain: strict;
      animation: e3-out linear both;
      animation-timeline: scroll(root);
      animation-range: 0 50svh;
    }
    :global(html[data-hero-zoom='laptop']) .hero-landed {
      display: block;
      align-self: start;
      aspect-ratio: 1192 / 1122;
      background: var(--e3-landed) center / 100% 100% no-repeat;
      pointer-events: none;
    }
    /* Once the canvas has painted its first frame (data-hero3d), the overlay hands off within 4vh. */
    :global(html[data-hero-zoom='laptop'][data-hero3d]) .hero-screen {
      animation: e3-fade linear both;
      animation-timeline: scroll(root);
      animation-range: 0.5vh 4vh;
    }
    :global(html[data-hero-zoom='laptop'][data-hero3d]) .hero-bare,
    :global(html[data-hero-zoom='laptop'][data-hero3d]) .hero-laptop {
      display: block;
      animation: e3-fade linear both;
      animation-timeline: scroll(root);
      animation-range: 80vh 89vh;
    }
    :global(html[data-hero-zoom='laptop']) .hero-bare {
      align-self: start;
      aspect-ratio: 1192 / 1122;
      background: var(--e3-bare) center / 100% 100% no-repeat;
      pointer-events: none;
    }
    .hero-laptop {
      position: sticky;
      top: 0;
      width: 100%;
      height: 100svh;
      z-index: 4;
      pointer-events: none;
    }
  }
  @keyframes e3-out {
    to {
      opacity: 0;
      transform: scale(0.92);
      visibility: hidden;
    }
  }
  @keyframes e3-fade {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
  @keyframes e3-copy {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
</style>
