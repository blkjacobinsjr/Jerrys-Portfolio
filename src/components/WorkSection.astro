---
import { Image } from 'astro:assets';
import WorkCards from './WorkCards.astro';
import DecryptedText from './DecryptedText';
import LogoLoop from './LogoLoop';
import { earlier } from '../data/site';
import { resolveProjects } from '../lib/work';
import tools from '../data/stack.json';

// Logo files written by tools/fetch-logos.mjs (logo.dev with a token, Simple Icons without).
const logoUrls = import.meta.glob<string>('../assets/logos/*', { eager: true, query: '?url', import: 'default' });
const logos = tools.stack.map(({ name, file }) => ({
  src: logoUrls[`../assets/logos/${file}`]!,
  alt: name,
  title: name,
  width: 24,
  height: 24,
}));

const items = await resolveProjects();
---

<section class="work wide" id="work" aria-labelledby="work-title">
  <h2 id="work-title" class="label"><DecryptedText client:afterload="(hover: hover) and (pointer: fine)" text="Selected work" sequential speed={40} encryptedClassName="decrypting" /></h2>
  <WorkCards items={items} />

  <details class="earlier">
    <summary>
      <span>Earlier work</span>
      <span class="muted">{earlier.length} projects</span>
    </summary>
    <ul>
      {
        earlier.map((item) => (
          <li>
            <Image src={item.thumb} alt="" width={44} height={44} densities={[1, 2]} loading="lazy" />
            <span class="earlier-text">
              {item.url ? (
                <a href={item.url} target="_blank" rel="noopener">
                  {item.name}
                </a>
              ) : (
                <span>{item.name}</span>
              )}
              <span class="muted">{item.note}</span>
            </span>
            <span class="muted earlier-year">{item.year}</span>
          </li>
        ))
      }
    </ul>
  </details>

  <div class="tools" aria-labelledby="tools-title">
    <h3 class="label" id="tools-title">Tools I build with</h3>
    <LogoLoop
      client:visible={{ rootMargin: '300px' }}
      logos={logos}
      speed={36}
      logoHeight={26}
      gap={52}
      pauseOnHover
      scaleOnHover
      labels="hover"
      ariaLabel="Tools I build with"
    />
  </div>
</section>

<style>
  .work {
    display: grid;
    gap: 1.5rem;
    padding-block: var(--section-gap) 0;
  }

  /* Phones: straight after the hero's Startup programs row, the full section gap read as an empty screen. */
  @media (max-width: 899px) {
    :global(.hero) + .work,
    :global(.hero-pin) + .work {
      padding-top: clamp(2rem, 8vw, 3rem);
    }
  }

  /* Full bleed: the loop runs edge to edge under the section. */
  .tools {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    /* Reserve the hydrated loop height (78px) so a late client:visible island
       cannot shift deep-link anchors below it. */
    grid-template-rows: auto minmax(78px, auto);
    gap: 1.25rem;
    width: 100vw;
    margin: clamp(3rem, 8vh, 5rem) calc(50% - 50vw) 0;
  }

  .tools .label {
    width: min(100% - 2 * var(--gutter), var(--col));
    margin-inline: auto;
  }

  .earlier {
    width: min(100%, var(--col));
    margin: clamp(3rem, 8vh, 5rem) auto 0;
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }

  .earlier summary {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .earlier summary::-webkit-details-marker {
    display: none;
  }

  .earlier summary::after {
    content: '+';
    margin-left: 0.75rem;
    color: var(--fg-2);
    transition: rotate var(--dur-ui) var(--ease-out);
  }

  .earlier[open] summary::after {
    rotate: 45deg;
  }

  .earlier summary > :first-child {
    flex: 1;
  }

  /* Progressive disclosure that animates its own height (interpolate-size). */
  .earlier::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size var(--dur-move) var(--ease-drawer),
      content-visibility var(--dur-move) allow-discrete;
  }

  .earlier[open]::details-content {
    block-size: auto;
  }

  @supports (interpolate-size: allow-keywords) {
    .earlier {
      interpolate-size: allow-keywords;
    }
  }

  .earlier ul {
    display: grid;
    gap: 1rem;
    padding: 1rem 0 0.5rem;
  }

  .earlier li {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: center;
    gap: 0.875rem;
    font-size: var(--text-sm);
  }

  .earlier li :global(img) {
    width: 44px;
    height: 44px;
    border-radius: var(--r-tile);
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--line);
  }

  .earlier-text {
    display: grid;
  }

  .earlier-year {
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .earlier::details-content {
      transition: none;
    }
  }
</style>
