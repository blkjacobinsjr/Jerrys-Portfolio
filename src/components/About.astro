---
import { Image } from 'astro:assets';
import ebike from '../assets/icons/ebike.webp';
import kindle from '../assets/icons/kindle.webp';
import podcast from '../assets/icons/podcast.webp';
import { person, testimonials } from '../data/site';

const statement =
  'German efficiency meets Ghanaian resilience. Years in marketing and customer support taught me why people buy. Teaching myself design and code let me build what they buy.';
const words = statement.split(' ');
// Each word gets its own slice of the scroll; together they span 82% of the stage.
const step = 82 / words.length;
---

<section class="about" id="about" aria-labelledby="about-title">
  <h2 id="about-title" class="sr-only">About</h2>
  <div class="statement-stage">
    <p class="statement col" style={`--step: ${step}%`}>
      {words.map((word, i) => [<span class="word" style={`--i: ${i}`}>{word}</span>, ' '])}
    </p>
  </div>

  <div class="col">

    <p class="downtime">
      Off screen I am an
      <span class="inline-icon"><Image src={ebike} alt="" widths={[64, 128]} sizes="2.25em" loading="lazy" /></span>
      e-bike explorer, a
      <span class="inline-icon"><Image src={kindle} alt="" widths={[64, 128]} sizes="2.25em" loading="lazy" /></span>
      Kindle highlighter, and a
      <span class="inline-icon"><Image src={podcast} alt="" widths={[64, 128]} sizes="2.25em" loading="lazy" /></span>
      Founders podcast devotee.
    </p>

    <p class="about-cv">
      <a href={person.cv} download>Download my CV</a>
      <span class="muted">PDF, 2023</span>
    </p>

    <ul class="quotes" aria-label="What people say">
      {
        testimonials.map((t) => (
          <li class="quote" data-reveal>
            <blockquote>
              <p>“{t.quote}”</p>
            </blockquote>
            <p class="quote-by">
              <Image src={t.avatar} alt="" width={40} height={40} densities={[1, 2]} loading="lazy" />
              <span>
                {t.name}
                <span class="muted">{t.context}</span>
              </span>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section-gap);
  }

  .statement {
    font-size: var(--text-statement);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }

  .word {
    display: inline-block;
  }

  /* The sentence resolves as you read it: the statement holds still on a tall
     stage while each word, in turn, goes from faint and blurred through a warm
     glow to sharp. Compositor-driven; static wherever scroll timelines are missing. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .statement-stage {
        height: 230svh;
        view-timeline: --statement block;
      }

      .statement {
        position: sticky;
        top: 0;
        display: flex;
        flex-wrap: wrap;
        align-content: center;
        column-gap: 0.26em;
        min-height: 100svh;
      }

      .word {
        animation: word-in linear both;
        animation-timeline: --statement;
        animation-range: contain calc(4% + var(--i) * var(--step)) contain calc(14% + var(--i) * var(--step));
      }
    }
  }

  /* Unread words stay fully opaque at half ink (over 4:1 against the page,
     above the 3:1 large-text bar) and blurred; reading sharpens them to full ink. */
  @keyframes word-in {
    from {
      color: color-mix(in oklch, var(--fg) 50%, var(--bg));
      filter: blur(9px);
      text-shadow: 0 0 0 transparent;
      transform: translateY(0.12em);
    }
    55% {
      text-shadow: 0 0 22px color-mix(in oklch, var(--accent) 45%, transparent);
    }
    to {
      color: var(--fg);
      filter: blur(0);
      text-shadow: 0 0 0 transparent;
      transform: none;
    }
  }

  .downtime {
    margin-top: clamp(1rem, 4vh, 3rem);
    font-size: var(--text-lg);
    line-height: 2;
    color: var(--fg-2);
  }

  .inline-icon {
    display: inline-block;
    width: 2.25em;
    height: 2.25em;
    margin: -0.75em 0.1em -0.6em;
    vertical-align: middle;
    transition: transform var(--dur-move) var(--ease-out);
  }

  .inline-icon :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .inline-icon:hover {
      transform: translateY(-4px) rotate(-6deg) scale(1.12);
      transition-timing-function: cubic-bezier(0.34, 1.9, 0.64, 1);
    }
  }

  .about-cv {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    font-size: var(--text-sm);
  }

  .quotes {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(4rem, 10vh, 6rem);
  }

  .quote blockquote {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.55;
    letter-spacing: -0.01em;
  }

  .quote-by {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    font-size: var(--text-sm);
  }

  .quote-by :global(img) {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }

  .quote-by > span {
    display: grid;
  }
</style>
