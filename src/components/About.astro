---
import { Image } from 'astro:assets';
import ebike from '../assets/icons/ebike.webp';
import kindle from '../assets/icons/kindle.webp';
import podcast from '../assets/icons/podcast.webp';
import { path, person } from '../data/site';
import { recommendations, honoraryMention } from '../data/recommendations';

const statement =
  'German efficiency meets Ghanaian resilience. Years in marketing and customer support taught me why people buy. Teaching myself design and code let me build what they buy.';
const words = statement.split(' ');
// The downtime line reads on in the same stage; its icons count as words.
const downtime = [
  'Off', 'screen', 'I', 'am', 'an', ebike, 'e-bike', 'explorer,', 'a', kindle, 'Kindle', 'highlighter,',
  'and', 'a', podcast, 'Founders', 'podcast', 'devotee.',
] as const;
// Each unit gets its own slice of the scroll; together they span 84% of the stage.
const step = 84 / (words.length + downtime.length);
// Read words light up in the colours of the path, one stop after another.
const unit = (i: number) => `--i: ${i}; --c: ${path[i % path.length]!.glow}`;
---

<section class="about" id="about" aria-labelledby="about-title">
  <h2 id="about-title" class="sr-only">About</h2>
  <div class="statement-stage">
    <div class="statement-group col" style={`--step: ${step}%`}>
      <p class="statement">
        {words.map((word, i) => [<span class="word" style={unit(i)}>{word}</span>, ' '])}
      </p>
      <p class="downtime">
        {
          downtime.map((part, j) => [
            typeof part === 'string' ? (
              <span class="word" style={unit(words.length + j)}>{part}</span>
            ) : (
              <span class="word inline-icon" style={unit(words.length + j)}>
                <Image src={part} alt="" widths={[64, 128]} sizes="2.25em" loading="lazy" />
              </span>
            ),
            ' ',
          ])
        }
      </p>
    </div>
  </div>

  <div class="col">
    <p class="about-cv">
      <a href={person.cv} download>Download my CV</a>
      <span class="muted">PDF, 2023</span>
    </p>
  </div>

  <div class="recs wide" data-recs>
    <div class="recs-head">
      <h3 class="label" id="recs-title">Recommendations</h3>
      <div class="recs-nav">
        <button type="button" class="recs-arrow" data-dir="-1" aria-label="Previous recommendation" disabled>
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" class="recs-arrow" data-dir="1" aria-label="Next recommendation">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </div>
    <ul class="recs-track" aria-labelledby="recs-title" tabindex="0" data-recs-track>
      {
        recommendations.map((recommendation) => (
          <li class="rec">
            <figure class="rec-card">
              <blockquote class="rec-quote">
                <p>“{recommendation.quote}”</p>
              </blockquote>
              <figcaption class="rec-caption">
                <div class="rec-person">
                  <Image src={recommendation.portrait} alt="" widths={[96, 160]} sizes="3.5rem" loading="lazy" />
                  <div class="rec-byline">
                    <a href={recommendation.linkedin} target="_blank" rel="noopener noreferrer">{recommendation.name}</a>
                    <span class="rec-role">{recommendation.position.title}</span>
                    <span class="rec-detail">{recommendation.position.detail}</span>
                  </div>
                </div>
                {
                  recommendation.position.kind === 'employer' && (
                    <a
                      class="rec-company"
                      href={recommendation.position.companyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={recommendation.position.company}
                    >
                      <Image src={recommendation.position.logo} alt={recommendation.position.company} widths={[96, 160]} sizes="5rem" loading="lazy" />
                    </a>
                  )
                }
                <span class="rec-proof">{recommendation.proof}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
    <aside class="rec-more honorary-mention" aria-labelledby="honorary-title">
      <h4 class="label" id="honorary-title">Honorary mention</h4>
      <figure class="rec-more-card">
        <blockquote><p><a href={honoraryMention.source.href} target="_blank" rel="noopener noreferrer">“{honoraryMention.quote}”</a></p></blockquote>
        <figcaption>
          <div class="rec-more-person">
            <Image src={honoraryMention.portrait.image} alt="" widths={[72, 112]} sizes="2.75rem" loading="lazy" />
            <div class="rec-byline">
              <a href={honoraryMention.linkedin} target="_blank" rel="noopener noreferrer">{honoraryMention.name}</a>
              <span class="rec-role">{honoraryMention.title}</span>
              <span class="rec-source"><a href={honoraryMention.source.href} target="_blank" rel="noopener noreferrer">{honoraryMention.source.label}</a></span>
            </div>
          </div>
          <a class="rec-more-company" href={honoraryMention.companyUrl} target="_blank" rel="noopener noreferrer" aria-label={honoraryMention.company}>
            <Image src={honoraryMention.logo} alt={honoraryMention.company} widths={[80, 128]} sizes="4rem" loading="lazy" />
          </a>
        </figcaption>
      </figure>
    </aside>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section-gap);
  }

  .statement {
    font-size: var(--text-statement);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }

  .word {
    display: inline-block;
    --from: color-mix(in oklch, var(--fg) 50%, var(--bg));
    --ink: var(--fg);
  }

  .downtime {
    margin-top: clamp(1.5rem, 5vh, 3rem);
    font-size: var(--text-lg);
    line-height: 2;
    color: var(--fg-2);
  }

  /* Small text: unread words start at the muted ink (4.5:1), not fainter. */
  .downtime .word {
    --from: var(--fg-2);
  }

  /* The sentence, then the downtime line, resolve as you read them: the group
     holds still on a tall stage while each word in turn goes from blurred,
     through the colour of one stop on the path, to sharp ink. Compositor-
     driven; static wherever scroll timelines are missing. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .statement-stage {
        height: 320svh;
        view-timeline: --statement block;
      }

      .statement-group {
        position: sticky;
        top: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 100svh;
      }

      .statement,
      .downtime {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
      }

      .statement {
        column-gap: 0.26em;
      }

      .downtime {
        column-gap: 0.3em;
      }

      .word {
        animation: word-in linear both;
        animation-timeline: --statement;
        animation-range: contain calc(3% + var(--i) * var(--step)) contain calc(16% + var(--i) * var(--step));
      }

      .inline-icon {
        animation-name: icon-in;
      }
    }
  }

  /* Unread words stay fully opaque (the statement at half ink, over 4:1 at its
     size) and blurred. Reading passes each one through its stop colour, held
     dark enough to read, then settles it to ink. */
  @keyframes word-in {
    from {
      color: var(--from);
      filter: blur(9px);
      text-shadow: 0 0 0 transparent;
      transform: translateY(0.12em);
    }
    35% {
      color: color-mix(in oklch, var(--c) 78%, var(--fg));
      filter: blur(1.5px);
      text-shadow: 0 0 24px color-mix(in oklch, var(--c) 55%, transparent);
    }
    65% {
      color: color-mix(in oklch, var(--c) 40%, var(--ink));
      text-shadow: 0 0 12px color-mix(in oklch, var(--c) 25%, transparent);
    }
    to {
      color: var(--ink);
      filter: blur(0);
      text-shadow: 0 0 0 transparent;
      transform: none;
    }
  }

  /* The little objects come into focus and into colour. */
  @keyframes icon-in {
    from {
      filter: blur(6px) grayscale(1);
      transform: translateY(0.12em) scale(0.86);
    }
    40% {
      filter: blur(1px) grayscale(0.3) drop-shadow(0 0 10px color-mix(in oklch, var(--c) 60%, transparent));
    }
    to {
      filter: blur(0) grayscale(0) drop-shadow(0 0 0 transparent);
      transform: none;
    }
  }

  .inline-icon {
    width: 2.25em;
    height: 2.25em;
    margin: -0.75em 0.1em -0.6em;
    vertical-align: middle;
    transition:
      translate var(--dur-move) var(--ease-out),
      rotate var(--dur-move) var(--ease-out),
      scale var(--dur-move) var(--ease-out);
  }

  .inline-icon :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    /* Individual transforms, so the hop composes with the scroll reveal. */
    .inline-icon:hover {
      translate: 0 -4px;
      rotate: -6deg;
      scale: 1.12;
      transition-timing-function: cubic-bezier(0.34, 1.9, 0.64, 1);
    }
  }

  .about-cv {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    font-size: var(--text-sm);
  }

  /* Recommendations use white quote cards with the person and role beneath. */
  .recs {
    margin-top: clamp(4rem, 10vh, 6rem);
  }

  .recs-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .recs-nav {
    display: flex;
    gap: 0.5rem;
  }

  .recs-arrow {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: var(--r-pill);
    background: var(--fg);
    color: var(--bg);
    cursor: pointer;
    transition: transform var(--dur-press) var(--ease-out), opacity var(--dur-ui) ease;
  }

  .recs-arrow:active {
    transform: scale(0.94);
  }

  .recs-arrow:disabled {
    opacity: 0.2;
    cursor: default;
  }

  @media (hover: none) {
    .recs-nav {
      display: none;
    }
  }

  .recs-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(84vw, 25rem);
    gap: 1rem;
    margin-inline: calc(-1 * var(--gutter));
    padding: 0 var(--gutter) 0.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    mask-image: linear-gradient(to right, transparent, #000 var(--gutter), #000 calc(100% - 3rem), transparent);
  }

  .recs-track::-webkit-scrollbar {
    display: none;
  }

  .recs-track:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 4px;
  }

  .rec {
    scroll-snap-align: start;
  }

  .rec-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 100%;
    margin: 0;
    min-height: 25rem;
    padding: 1.35rem;
    border: 1px solid #dedede;
    border-radius: 1.125rem;
    background: #fff;
    color: #171717;
  }

  .rec-quote {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .rec-quote p,
  .rec-more-card blockquote p {
    margin: 0;
  }

  .rec-proof {
    grid-column: 1 / -1;
    padding-left: 3.5rem;
    color: #4d4d4d;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .rec-caption {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.5rem;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid #e5e5e5;
  }

  .rec-person,
  .rec-more-person {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .rec-person :global(img),
  .rec-more-person :global(img) {
    flex: 0 0 auto;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .rec-byline {
    display: grid;
    min-width: 0;
    gap: 0.12rem;
    color: #4d4d4d;
    font-size: 0.74rem;
    line-height: 1.35;
  }

  .rec-byline > a {
    width: fit-content;
    color: #171717;
    font-size: 0.95rem;
    font-weight: 650;
    line-height: 1.25;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }

  .rec-role {
    color: #252525;
    font-weight: 550;
  }

  .rec-detail,
  .rec-context {
    color: #5a5a5a;
  }

  .rec-company,
  .rec-more-company {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 4.5rem;
    height: 2.75rem;
    border-radius: 0.5rem;
  }

  .rec-company {
    width: 2.5rem;
    height: 2.5rem;
  }

  .rec-person { gap: 0.75rem; }
  .rec-person :global(img) { width: 2.75rem; height: 2.75rem; }

  .rec-company :global(img),
  .rec-more-company :global(img) {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    object-fit: contain;
  }

  .rec-more {
    margin-top: 2rem;
  }

  .rec-more > .label {
    margin-bottom: 1rem;
  }

  .rec-more-card {
    max-width: 28rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 13rem;
    height: 100%;
    margin: 0;
    padding: 1.15rem;
    border: 1px solid #dedede;
    border-radius: 1rem;
    background: #fff;
    color: #171717;
  }

  .rec-more-card blockquote {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .rec-more-card blockquote a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }

  .rec-more-card figcaption {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.8rem;
    border-top: 1px solid #e5e5e5;
  }

  .rec-more-person :global(img) {
    width: 2.75rem;
    height: 2.75rem;
  }


  .rec-more-company {
    width: 3.75rem;
    height: 2.25rem;
  }

  .rec-source {
    font-size: 0.68rem;
    color: #686868;
  }

  .rec-source a {
    color: inherit;
  }

  @media (prefers-reduced-motion: reduce) {
    .recs-arrow {
      transition: none;
    }

    .recs-arrow:active {
      transform: none;
    }
  }
</style>

<script>
  // Arrows step the recommendations carousel one card at a time.
  for (const root of document.querySelectorAll<HTMLElement>('[data-recs]')) {
    const track = root.querySelector<HTMLElement>('[data-recs-track]')!;
    const [prev, next] = root.querySelectorAll<HTMLButtonElement>('.recs-arrow');
    const sync = () => {
      prev!.disabled = track.scrollLeft < 4;
      next!.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 4;
    };
    root.addEventListener('click', (event) => {
      const arrow = (event.target as Element).closest<HTMLElement>('.recs-arrow');
      const card = track.querySelector<HTMLElement>('.rec');
      if (!arrow || !card) return;
      const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollBy({ left: Number(arrow.dataset.dir) * (card.offsetWidth + 16), behavior: smooth ? 'smooth' : 'auto' });
    });
    track.addEventListener('scroll', sync, { passive: true });
    sync();
  }
</script>
