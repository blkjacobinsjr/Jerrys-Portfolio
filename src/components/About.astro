---
import { Image } from 'astro:assets';
import ebike from '../assets/icons/ebike.webp';
import kindle from '../assets/icons/kindle.webp';
import podcast from '../assets/icons/podcast.webp';
import { person, testimonials } from '../data/site';

const statement =
  'German efficiency meets Ghanaian resilience. A decade in marketing taught me why people buy. Teaching myself design and code let me build what they buy.';
const words = statement.split(' ');
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="col">
    <h2 id="about-title" class="label">About</h2>
    <p class="statement">
      {words.map((word) => <span class="word">{word} </span>)}
    </p>

    <p class="downtime">
      Off screen I am an
      <span class="inline-icon"><Image src={ebike} alt="" widths={[64, 128]} sizes="2.25em" loading="lazy" /></span>
      e-bike explorer, a
      <span class="inline-icon"><Image src={kindle} alt="" widths={[64, 128]} sizes="2.25em" loading="lazy" /></span>
      Kindle highlighter, and a
      <span class="inline-icon"><Image src={podcast} alt="" widths={[64, 128]} sizes="2.25em" loading="lazy" /></span>
      Founders podcast devotee.
    </p>

    <p class="about-cv">
      <a href={person.cv} download>Download my CV</a>
      <span class="muted">PDF, 2023</span>
    </p>

    <ul class="quotes" aria-label="What people say">
      {
        testimonials.map((t) => (
          <li class="quote" data-reveal>
            <blockquote>
              <p>“{t.quote}”</p>
            </blockquote>
            <p class="quote-by">
              <Image src={t.avatar} alt="" width={40} height={40} densities={[1, 2]} loading="lazy" />
              <span>
                {t.name}
                <span class="muted">{t.context}</span>
              </span>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section-gap);
  }

  .statement {
    margin-top: 1.25rem;
    font-size: var(--text-statement);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }

  /* Each word lights up as it crosses the reading line. Pure CSS, off the main thread. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .word {
        animation: word-on linear both;
        animation-timeline: view();
        animation-range: cover 18% cover 42%;
      }
    }
  }

  @keyframes word-on {
    from {
      opacity: 0.16;
    }
  }

  .downtime {
    margin-top: 3rem;
    font-size: var(--text-lg);
    line-height: 2;
    color: var(--fg-2);
  }

  .inline-icon {
    display: inline-block;
    width: 2.25em;
    height: 2.25em;
    margin: -0.75em 0.1em -0.6em;
    vertical-align: middle;
    transition: transform 400ms var(--ease-out);
  }

  .inline-icon :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .inline-icon:hover {
      transform: translateY(-4px) rotate(-6deg) scale(1.12);
      transition-timing-function: cubic-bezier(0.34, 1.9, 0.64, 1);
    }
  }

  .about-cv {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    font-size: var(--text-sm);
  }

  .quotes {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(4rem, 10vh, 6rem);
  }

  .quote blockquote {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.55;
    letter-spacing: -0.01em;
  }

  .quote-by {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    font-size: var(--text-sm);
  }

  .quote-by :global(img) {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }

  .quote-by > span {
    display: grid;
  }
</style>
