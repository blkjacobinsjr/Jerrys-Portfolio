<style>
  .programs {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    text-align: center;
  }
  .programs h2 {
    margin: 0;
    text-wrap: balance;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-2);
  }
  .programs ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .programs li {
    display: flex;
    color: var(--fg-2);
    transition: color 0.2s ease;
  }
  .programs svg {
    display: block;
    height: 1.25rem;
    width: auto;
  }
  .programs-word {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.25rem;
  }
  @media (hover: hover) {
    .programs li:hover {
      color: var(--fg);
    }
  }
</style>
