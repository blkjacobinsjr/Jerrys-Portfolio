        <div id="tt-draper" role="tooltip" class="tooltip">Draper University</div>
      </li>
      <li tabindex="0" data-tooltip-id="tt-launch" aria-describedby="tt-launch" class="launch-item">
        <span class="programs-word" role="img" aria-label="LAUNCH (Jason Calacanis)" title="LAUNCH (Jason Calacanis)">LAUNCH</span>
        <div id="tt-launch" role="tooltip" class="tooltip">LAUNCH (Jason Calacanis)</div>
      </li>
  </ul>
  <div class="p17-tooltip" aria-hidden="true" data-show="false"><span class="p17-tooltip-text"></span></div>
  </div>
</section>

<style>
  .programs {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    text-align: center;
  }
  .programs h2 {
    margin: 0;
    text-wrap: balance;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-2);
  }
  .programs ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .programs li {
    position: relative;
    display: flex;
    color: var(--fg-2);
    transition: color 0.2s ease;
    cursor: default;
    outline: none;
  }
  .programs li:active {
    color: var(--fg);
  }
  @media (hover: hover) {
    .programs li:active {
      transform: scale(0.97);
      transition: transform 0.1s ease-out;
    }
  }
  .programs svg {
    display: block;
    height: 1.25rem;
    width: auto;
  }
  .programs-word {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.25rem;
  }
  /* Each mark keeps its own role="tooltip" description for assistive tech; it is visually hidden. */
  .tooltip {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (hover: hover) {
    .programs li:hover {
      color: var(--fg);
    }
  }
  .programs li:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
    border-radius: var(--r-base);
  }
  /* Verbatim transitions.dev "Tooltip open/close" (detail.html?t=tooltip-open-close, prototype 17): one tooltip per
     group that travels between triggers. Appear: 150ms ease-out after an 80ms delay, scale 0.98 to 1 from the bottom
     centre. Exit: 50ms ease-out with no delay. Travel and width: 160ms cubic-bezier(0.22, 1, 0.36, 1), no delay. */
  .programs-row {
    position: relative;
    --p17-in-dur: 150ms;
    --p17-out-dur: 50ms;
    --p17-scale-from: 0.98;
    --p17-delay: 80ms;
    --p17-in-ease: ease-out;
    --p17-out-ease: ease-out;
    --p17-move-dur: 160ms;
    --p17-move-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --p17-bg: #ffffff;
    --p17-fg: #2f2f2f;
  }
  .p17-tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0;
    z-index: 1000;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 0;
    overflow: hidden;
    translate: var(--p17-x, 0px) 0;
    scale: var(--p17-scale-from);
    transform-origin: 50% 100%;
    padding: 8px 10px;
    border-radius: 10px;
    background: var(--p17-bg);
    color: var(--p17-fg);
    font-size: 13px;
    font-weight: 400;
    line-height: 18px;
    white-space: nowrap;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.06),
      0 2px 6px 0 rgba(0, 0, 0, 0.05),
      0 4px 42px 0 rgba(0, 0, 0, 0.06);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--p17-out-dur) var(--p17-out-ease),
      scale var(--p17-out-dur) var(--p17-out-ease),
      translate var(--p17-move-dur) var(--p17-move-ease),
      width var(--p17-move-dur) var(--p17-move-ease);
  }
  .p17-tooltip-text {
    white-space: nowrap;
  }
  @media (prefers-color-scheme: dark) {
    .programs-row {
      --p17-bg: #222222;
      --p17-fg: #f0f0f0;
    }
    .p17-tooltip {
      box-shadow:
        inset 0 0 0 1px rgba(255, 255, 255, 0.03),
        0 1px 1px 0 rgba(0, 0, 0, 0.08),
        0 2px 6px 0 rgba(0, 0, 0, 0.15);
    }
  }
  /* The appear delay belongs only to the show rule, so hiding snaps it back to 0; a retarget while showing moves at once. */
  .p17-tooltip[data-show='true'] {
    opacity: 1;
    scale: 1;
    transition:
      opacity var(--p17-in-dur) var(--p17-in-ease) var(--p17-delay),
      scale var(--p17-in-dur) var(--p17-in-ease) var(--p17-delay),
      translate var(--p17-move-dur) var(--p17-move-ease),
      width var(--p17-move-dur) var(--p17-move-ease);
  }
  @media (prefers-reduced-motion: reduce) {
    .programs li:active {
      transform: none;
    }
  }
</style>

<script>
  // transitions.dev initP17, verbatim logic: measure the label, centre the tip over the trigger, snap the geometry
  // while hidden so only the appear plays, glide it while shown. Tap toggles it on touch; Escape and outside taps hide it.
  const group = document.querySelector<HTMLElement>('[data-proto-tooltip]');
  const tip = group?.querySelector<HTMLElement>('.p17-tooltip');
  const text = group?.querySelector<HTMLElement>('.p17-tooltip-text');
  if (group && tip && text) {
    const triggers = [...group.querySelectorAll<HTMLElement>('[data-programs] > li')];
    let current: HTMLElement | null = null;
    const hide = () => {
      current = null;
      tip.setAttribute('data-show', 'false');
    };
    const place = (trigger: HTMLElement) => {
      const showing = tip.getAttribute('data-show') === 'true';
      current = trigger;
      text.textContent = trigger.querySelector('[role="tooltip"]')?.textContent ?? '';
      const cs = getComputedStyle(tip);
      const width = Math.ceil(text.scrollWidth + parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight));
      const g = group.getBoundingClientRect();
      const r = trigger.getBoundingClientRect();
      const x = r.left - g.left + r.width / 2 - width / 2;
      if (!showing) {
        tip.style.transition = 'none';
        tip.style.width = `${width}px`;
        tip.style.setProperty('--p17-x', `${x}px`);
        void tip.offsetWidth;
        tip.style.transition = '';
      } else {
        tip.style.width = `${width}px`;
        tip.style.setProperty('--p17-x', `${x}px`);
      }
      tip.setAttribute('data-show', 'true');
    };
    for (const t of triggers) {
      t.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') place(t);
      });
      t.addEventListener('focus', () => place(t));
      t.addEventListener('blur', hide);
      t.addEventListener('click', () => (current === t && tip.getAttribute('data-show') === 'true' ? hide() : place(t)));
    }
    group.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') hide();
    });
    document.addEventListener('click', (e) => {
      if (!group.contains(e.target as Node)) hide();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hide();
    });
  }
</script>
