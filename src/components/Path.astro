---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import NowBadge from './NowBadge';
import DecryptedText from './DecryptedText';
import PathSheet, { type Picture, type StopView } from './PathSheet';
import StopLogo from './StopLogo';
import PathGallery from './PathGallery';
import { path } from '../data/site';

const icons = import.meta.glob<{ default: ImageMetadata }>('../assets/icons/*.webp', { eager: true });
const icon = (id: string) => {
  const mod = icons[`../assets/icons/${id}.webp`];
  if (!mod) throw new Error(`Missing diorama for path stop "${id}"`);
  return mod.default;
};
const TICKS_PER_STOP = 6;

async function picture(src: ImageMetadata, widths: number[], alt: string): Promise<Picture> {
  const img = await getImage({ src, widths, format: 'webp' });
  return { src: img.src, srcset: img.srcSet.attribute, width: src.width, height: src.height, alt };
}

// What the drawer needs per stop, with images already resized for it.
const views: StopView[] = await Promise.all(
  path.map(async ({ flag: _flag, photos = [], badge, logo, ...stop }) => ({
    ...stop,
    logo: logo && (await getImage({ src: logo, width: 48, format: 'webp' })).src,
    badge: badge && { front: badge.front.src, back: badge.back.src, strap: badge.strap.src },
    model: await picture(icon(stop.id), [400, 680, 960], `A miniature 3D model of ${stop.place}`),
    photos: await Promise.all(photos.map((p) => picture(p.src, [480, 960], p.alt))),
  })),
);

// What the canvas draws: the same dioramas as the strip, one size for every screen.
const galleryStops = await Promise.all(
  path.map(async (stop) => ({
    id: stop.id,
    src: (await getImage({ src: icon(stop.id), width: 640, format: 'webp' })).src,
    gray: stop.flag === 'declined' ? 0.6 : 0,
  })),
);
---

<section class="path" id="path" aria-labelledby="path-title">
  <div class="col path-head">
    <h2 id="path-title" class="label"><DecryptedText client:afterload="(hover: hover) and (pointer: fine)" text="Path" sequential speed={40} encryptedClassName="decrypting" /></h2>
    <p class="path-lede">Coventry, London, Berlin. From campaigns and support desks to shipping my own apps.</p>
  </div>

  <div class="path-pin" data-path-pin>
    <div class="path-stage">
    <div class="path-scroller" data-path-scroller>
      <ol class="path-track" data-path-track>
        {
          path.map((stop, i) => (
            <li class="stop" data-flag={stop.flag} style={`--glow: ${stop.glow}`}>
              <button class="stop-btn" type="button" data-stop={stop.id} aria-haspopup="dialog">
                {/* When and where on one muted line, the same as the drawer's meta line. */}
                <span class="stop-when">
                  {stop.flag === 'now' ? <NowBadge client:afterload /> : stop.when}
                  <span class="stop-where">{` · ${stop.where}`}</span>
                </span>
                <span class="stop-art">
                  <span class="stop-glow" aria-hidden="true"></span>
                  <Image src={icon(stop.id)} alt="" widths={[240, 360, 480]} sizes="(min-width: 900px) 260px, 56vw" loading="lazy" />
                </span>
                <span class="stop-place">
                  {views[i]!.logo && <StopLogo src={views[i]!.logo} name={stop.place} size={18} decorative />}
                  {stop.place}
                </span>
                <span class="stop-title">{stop.title}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>
    {/* Phones with the gallery running: the strip's own captions would ride the finger 1:1 while the drawn art
        eases behind it, so the stop in focus is captioned here instead, outside the drag layer, and crossfades on snap. */}
    <div class="path-caption" aria-hidden="true">
      {path.map((stop) => (
        <div class="path-caption-item" data-for={stop.id}>
          <span class="stop-when">{stop.flag === 'now' ? 'Now' : stop.when}<span class="stop-where">{` · ${stop.where}`}</span></span>
          <span class="stop-place">{stop.place}</span>
          <span class="stop-title">{stop.title}</span>
        </div>
      ))}
    </div>
    <PathGallery client:visible={{ rootMargin: '200px' }} stops={galleryStops} />
    </div>

    <div class="ruler" aria-hidden="true">
      {
        [0, 1].map((layer) => (
          <div class:list={['ruler-row', { 'ruler-row-done': layer === 1 }]}>
            {path.flatMap(() =>
              Array.from({ length: TICKS_PER_STOP }, (_, i) => <span class:list={['tick', { 'tick-major': i === 0 }]} />),
            )}
          </div>
        ))
      }
    </div>
  </div>
  <PathSheet client:afterload stops={views} />
</section>

<style>
  .path {
    padding-block: var(--section-gap) 0;
    timeline-scope: --path;
    /* The translated track must never widen the page. clip, unlike hidden, keeps pinning working. */
    overflow-x: clip;
  }

  .path-head {
    display: grid;
    gap: 0.5rem;
    margin-bottom: clamp(2rem, 6vh, 4rem);
  }

  .path-lede {
    font-size: var(--text-lg);
    letter-spacing: -0.012em;
  }

  .path-pin {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding-bottom: 2rem;
  }

  /* Phones and reduced motion: a native, snapping horizontal strip. */
  .path-scroller {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-timeline: --path x;
    scrollbar-width: none;
  }

  .path-scroller::-webkit-scrollbar {
    display: none;
  }

  .path-stage {
    position: relative;
  }

  /* Draws the dioramas over the strip once the gallery starts (PathGallery). It adds no layout. */
  .path-stage :global(.path-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* The first and the last stop each rest in the middle, so the strip has a clear start and end and its
     length never depends on whether the gallery runs. The bottom room holds the arc's outer stops. */
  .path-track {
    --stop-w: clamp(200px, 56vw, 280px);
    display: flex;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    width: max-content;
    padding-inline: calc(50% - var(--stop-w) / 2);
    padding-bottom: 4rem;
  }

  /* Desktop with motion: GSAP pins the section and moves the track. */
  :global(.is-pinned) .path-scroller {
    overflow: visible;
    scroll-snap-type: none;
  }

  .stop {
    scroll-snap-align: center;
    width: var(--stop-w);
  }

  .stop-btn {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    width: 100%;
    padding: 0.75rem 0.5rem 1rem;
    border: 0;
    border-radius: var(--r-card);
    background: none;
    text-align: center;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--dur-ui) ease,
      transform var(--dur-press) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .stop-btn:hover {
      background: var(--bg-sunk);
    }
  }

  .stop-btn:active {
    transform: scale(0.98);
  }

  /* Gallery running: the canvas draws this stop's diorama, so the flat image steps aside. Hover and press are
     transitions.dev "Avatar group hover" (the lift is set from path-gallery.ts); the canvas follows the transform. */
  .stop[data-gl] .stop-art :global(img) {
    opacity: 0;
  }

  .path[data-gl] .stop-btn {
    transform: translateY(var(--shift, 0px)) scale(var(--scale-active, 1));
    transition: transform var(--avatar-dur) var(--avatar-ease-in);
    will-change: transform;
  }

  .path[data-gl] .stop-btn:active {
    transform: translateY(var(--shift, 0px)) scale(calc(var(--scale-active, 1) * 0.98));
    transition-duration: var(--dur-press);
  }

  @media (hover: hover) and (pointer: fine) {
    .path[data-gl] .stop-btn:hover {
      background: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .path[data-gl] .stop-btn {
      transition: none;
      transform: none;
    }
  }

  :global(:root) {
    --avatar-lift: -4px;
    --avatar-dur: 320ms;
    --avatar-scale: 1.05;
    --avatar-falloff: 0.45;
    --avatar-ease-in: cubic-bezier(0.22, 1, 0.36, 1);
    --avatar-ease-out: cubic-bezier(0.34, 3.85, 0.64, 1);
  }

  /* Captions are one fixed-height line that ellipsises, so a long place never pushes the art or its neighbours. */
  .stop-when {
    display: block;
    height: 1.75rem;
    line-height: 1.75rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: center;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--fg-2);
  }

  .stop-art {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    margin-block: 0.25rem 0.5rem;
    isolation: isolate;
    /* Skipped (and its lazy image unfetched) until the stop comes near. */
    content-visibility: auto;
    contain-intrinsic-size: auto 280px auto 280px;
  }

  .stop-art :global(img) {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform-origin: 50% 100%;
  }

  /* The stop at the centre of the strip glows faintly in its own main colour.
     Phones: a CSS view timeline on the swipe strip. Desktop: GSAP while pinned. */
  .stop-glow {
    position: absolute;
    inset: 8% 0 0;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in oklch, var(--glow) 85%, transparent), transparent);
    filter: blur(30px);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .stop-glow {
        animation: glow-lit linear both;
        animation-timeline: view(inline);
      }
    }
  }

  :global(.is-pinned) .stop-glow {
    animation: none;
  }

  @keyframes glow-lit {
    0%,
    28% {
      opacity: 0;
    }
    50% {
      opacity: 0.7;
    }
    72%,
    100% {
      opacity: 0;
    }
  }

  [data-flag='declined'] .stop-art :global(img) {
    filter: saturate(0.4);
  }

  .stop-place {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    max-width: 100%;
    font-weight: 500;
    white-space: nowrap;
  }

  .stop-title {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--text-sm);
    color: var(--fg-2);
  }

  .stop-when :global(*) {
    vertical-align: middle;
  }

  /* While the circular gallery runs, the stop in the middle owns the caption and the others dim: the text
     crossfades from slide to slide as the art glides (lib/path-gallery.ts sets data-focus). */
  .path-caption {
    display: none;
  }

  @media (hover: none), (pointer: coarse) {
    /* The strip keeps its buttons (hit targets, focus, names); only its text and glow step aside. */
    .path[data-gl] .stop :is(.stop-when, .stop-place, .stop-title, .stop-glow) {
      visibility: hidden;
    }
    /* The caption band is reserved: the canvas fades out just above it, so a tall incoming diorama (or a
       neighbour's prop) can never paint through the date and place. */
    .path[data-gl] .path-stage :global(.path-canvas) {
      mask-image: linear-gradient(to bottom, #000 calc(100% - 6.5rem), transparent calc(100% - 4.75rem));
    }
    .path[data-gl] .path-caption {
      display: grid;
      z-index: 1;
      position: relative;
      height: 4.5rem;
      /* Net zero layout height (4.5 - 5.5 + 1): turning the gallery on never moves what follows (deep links). */
      margin-block: -5.5rem 1rem;
      pointer-events: none;
    }
    .path-caption-item {
      grid-area: 1 / 1;
      display: grid;
      justify-items: center;
      align-content: start;
      gap: 0.25rem;
      padding-inline: 1rem;
      text-align: center;
      opacity: 0;
      transition: opacity 240ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .path-caption-item[data-on] {
      opacity: 1;
    }
    .path-caption-item .stop-place {
      max-width: 100%;
    }
  }

  .path[data-gl] :is(.stop-when, .stop-place, .stop-title) {
    transition: opacity 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .path[data-gl] .stop:not([data-focus]) :is(.stop-when, .stop-place, .stop-title) {
    opacity: 0.25;
  }
  @media (prefers-reduced-motion: reduce) {
    .path[data-gl] :is(.stop-when, .stop-place, .stop-title) {
      transition: none;
    }
  }

  [data-flag='declined'] .stop-title {
    text-decoration: line-through;
    text-decoration-color: var(--accent);
  }

  /* Ruler: a light row of ticks and a dark copy clipped to progress. */
  .ruler {
    position: relative;
    height: 14px;
    width: min(100% - 2 * var(--gutter), 30rem);
    margin-inline: auto;
    --progress: 0;
  }

  .ruler-row {
    display: flex;
    justify-content: space-between;
    align-items: end;
    height: 14px;
  }

  .ruler-row-done {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc((1 - var(--progress)) * 100%) 0 0);
  }

  .tick {
    width: 1.5px;
    height: 7px;
    border-radius: 1px;
    background: color-mix(in oklch, var(--fg) 18%, transparent);
  }

  .tick-major {
    height: 14px;
    background: var(--fg-3);
  }

  .ruler-row-done .tick {
    background: var(--fg);
  }

  @supports (animation-timeline: scroll()) {
    .ruler-row-done {
      animation: ruler-fill linear both;
      animation-timeline: --path;
    }
  }

  @keyframes ruler-fill {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  :global(.is-pinned) .ruler-row-done {
    animation: none;
  }

</style>
