---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import NowBadge from './NowBadge';
import { path } from '../data/site';

const icons = import.meta.glob<{ default: ImageMetadata }>('../assets/icons/*.webp', { eager: true });
const icon = (id: string) => {
  const mod = icons[`../assets/icons/${id}.webp`];
  if (!mod) throw new Error(`Missing diorama for path stop "${id}"`);
  return mod.default;
};
const TICKS_PER_STOP = 6;
---

<section class="path" id="path" aria-labelledby="path-title">
  <div class="col path-head">
    <h2 id="path-title" class="label">Path</h2>
    <p class="path-lede">Coventry, London, Berlin. From campaigns and support desks to shipping my own apps.</p>
  </div>

  <div class="path-pin" data-path-pin>
    <div class="path-scroller" data-path-scroller>
      <ol class="path-track" data-path-track>
        {
          path.map((stop) => (
            <li class="stop" data-flag={stop.flag}>
              <button
                class="stop-btn"
                type="button"
                popovertarget={`stop-${stop.id}`}
                style={`anchor-name: --stop-${stop.id}`}
              >
                <span class="stop-when">{stop.flag === 'now' ? <NowBadge client:idle /> : stop.when}</span>
                <span class="stop-art">
                  <Image src={icon(stop.id)} alt="" widths={[240, 360, 480]} sizes="(min-width: 900px) 260px, 56vw" loading="lazy" />
                </span>
                <span class="stop-place">{stop.place}</span>
                <span class="stop-title">{stop.title}</span>
              </button>
              <div id={`stop-${stop.id}`} popover class="stop-pop" style={`position-anchor: --stop-${stop.id}`}>
                <p class="stop-pop-head">
                  <strong>{stop.place}</strong>
                  <span>{stop.where}</span>
                </p>
                <ul>
                  {stop.notes.map((note) => (
                    <li>{note}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="ruler" aria-hidden="true">
      {
        [0, 1].map((layer) => (
          <div class:list={['ruler-row', { 'ruler-row-done': layer === 1 }]}>
            {path.flatMap(() =>
              Array.from({ length: TICKS_PER_STOP }, (_, i) => <span class:list={['tick', { 'tick-major': i === 0 }]} />),
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .path {
    padding-block: var(--section-gap) 0;
    timeline-scope: --path;
    /* The translated track must never widen the page. clip, unlike hidden, keeps pinning working. */
    overflow-x: clip;
  }

  .path-head {
    display: grid;
    gap: 0.5rem;
    margin-bottom: clamp(2rem, 6vh, 4rem);
  }

  .path-lede {
    font-size: var(--text-lg);
    letter-spacing: -0.012em;
  }

  .path-pin {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    padding-bottom: 2rem;
  }

  /* Phones and reduced motion: a native, snapping horizontal strip. */
  .path-scroller {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-timeline: --path x;
    scrollbar-width: none;
  }

  .path-scroller::-webkit-scrollbar {
    display: none;
  }

  .path-track {
    display: flex;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    width: max-content;
    padding-inline: max(var(--gutter), calc((100vw - var(--wide)) / 2));
  }

  /* Desktop with motion: GSAP pins the section and moves the track. */
  :global(.is-pinned) .path-scroller {
    overflow: visible;
    scroll-snap-type: none;
  }

  .stop {
    scroll-snap-align: center;
    width: clamp(200px, 56vw, 280px);
  }

  .stop-btn {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    width: 100%;
    padding: 0.75rem 0.5rem 1rem;
    border: 0;
    border-radius: var(--r-card);
    background: none;
    text-align: center;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--dur-ui) ease,
      transform var(--dur-press) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .stop-btn:hover {
      background: var(--bg-sunk);
    }
  }

  .stop-btn:active {
    transform: scale(0.98);
  }

  .stop-when {
    display: grid;
    place-items: center;
    min-height: 1.75rem;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--fg-2);
  }

  .stop-art {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    margin-block: 0.25rem 0.5rem;
  }

  .stop-art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform-origin: 50% 100%;
  }

  [data-flag='declined'] .stop-art :global(img) {
    filter: saturate(0.4);
  }

  .stop-place {
    font-weight: 500;
  }

  .stop-title {
    font-size: var(--text-sm);
    color: var(--fg-2);
    text-wrap: balance;
  }

  [data-flag='declined'] .stop-title {
    text-decoration: line-through;
    text-decoration-color: var(--accent);
  }

  /* Disclosure: native popover, anchored above its stop where CSS anchor
     positioning exists, centered on screen where it does not. */
  .stop-pop {
    width: min(20rem, calc(100vw - 2rem));
    margin: 0;
    padding: 1rem 1.125rem;
    border: 0;
    border-radius: 18px;
    background: var(--bg-elev);
    color: var(--fg);
    font-size: var(--text-sm);
    box-shadow:
      0 0 0 1px var(--line),
      0 18px 48px -18px rgb(var(--shadow-tint) / 0.4);
    opacity: 1;
    transform: none;
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out),
      overlay 200ms allow-discrete,
      display 200ms allow-discrete;
  }

  @supports not (position-area: top) {
    .stop-pop {
      inset: 0;
      margin: auto;
      height: fit-content;
    }
  }

  @supports (position-area: top) {
    .stop-pop {
      position-area: top;
      position-try-fallbacks: flip-block;
      margin-bottom: -2.5rem;
      transform-origin: 50% 100%;
    }
  }

  .stop-pop:not(:popover-open) {
    opacity: 0;
    transform: scale(0.96) translateY(6px);
  }

  @starting-style {
    .stop-pop:popover-open {
      opacity: 0;
      transform: scale(0.96) translateY(6px);
    }
  }

  .stop-pop::backdrop {
    background: transparent;
  }

  .stop-pop-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .stop-pop-head span {
    color: var(--fg-2);
  }

  .stop-pop ul {
    display: grid;
    gap: 0.375rem;
    padding-left: 1rem;
    list-style: disc;
  }

  .stop-pop li::marker {
    color: var(--fg-3);
  }

  /* Ruler: a light row of ticks and a dark copy clipped to progress. */
  .ruler {
    position: relative;
    height: 14px;
    width: min(100% - 2 * var(--gutter), 30rem);
    margin-inline: auto;
    --progress: 0;
  }

  .ruler-row {
    display: flex;
    justify-content: space-between;
    align-items: end;
    height: 14px;
  }

  .ruler-row-done {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc((1 - var(--progress)) * 100%) 0 0);
  }

  .tick {
    width: 1.5px;
    height: 7px;
    border-radius: 1px;
    background: color-mix(in oklch, var(--fg) 18%, transparent);
  }

  .tick-major {
    height: 14px;
    background: var(--fg-3);
  }

  .ruler-row-done .tick {
    background: var(--fg);
  }

  @supports (animation-timeline: scroll()) {
    .ruler-row-done {
      animation: ruler-fill linear both;
      animation-timeline: --path;
    }
  }

  @keyframes ruler-fill {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  :global(.is-pinned) .ruler-row-done {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .stop-pop {
      transition: none;
    }
  }
</style>
