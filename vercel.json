{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/about.html", "destination": "/#about", "permanent": true },
    { "source": "/subzero.html", "destination": "/#work", "permanent": true },
    { "source": "/scenaryo.html", "destination": "/#work", "permanent": true },
    { "source": "/scenaryo-app.html", "destination": "/#work", "permanent": true },
    { "source": "/scenextras.html", "destination": "/#work", "permanent": true },
    { "source": "/pokefight.html", "destination": "/#work", "permanent": true },
    { "source": "/bm-musicvid.html", "destination": "/#work", "permanent": true },
    { "source": "/foodierecipes.html", "destination": "/#work", "permanent": true },
    { "source": "/priori-todo.html", "destination": "/#work", "permanent": true }
  ],
  "headers": [
    { "source": "/_astro/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    {
      "source": "/og.mp4",
      "headers": [
        { "key": "Content-Type", "value": "video/mp4" },
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }
      ]
    }
  ]
}
